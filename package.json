{
  "name": "vscode-markdown-live-editor",
  "displayName": "Markdown Live Editor",
  "description": "An Obsidian-like Live Preview Markdown editor for VS Code with ordinary Markdown as the source of truth.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=24 <25"
  },
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:vscodeMarkdownLiveEditor.showProjectInfo",
    "onCustomEditor:vscodeMarkdownLiveEditor.editor",
    "onView:vscodeMarkdownLiveEditor.markdownOutline"
  ],
  "contributes": {
    "configurationDefaults": {
      "[markdown]": {
        "files.trimTrailingWhitespace": false
      }
    },
    "configuration": {
      "title": "Markdown Live Editor",
      "properties": {
        "vscodeMarkdownLiveEditor.developmentDiagnosticMode": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "raw-cm6",
            "markdown",
            "sync",
            "preview"
          ],
          "markdownDescription": "Development-only ATOK layer-isolation mode. `raw-cm6` is local CodeMirror only; `markdown` adds the Markdown language; `sync` adds project document sync; `preview` adds live preview and the custom Save/Undo/Redo keymap. Diagnostic modes never constitute a release configuration."
        }
      }
    },
    "commands": [
      {
        "command": "vscodeMarkdownLiveEditor.showProjectInfo",
        "title": "Markdown Live Editor: Show Project Info"
      },
      {
        "command": "vscodeMarkdownLiveEditor.copyDiagnostics",
        "title": "Markdown Live Editor: Copy Diagnostic Metadata"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscodeMarkdownLiveEditor.editor",
        "displayName": "Markdown Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vscodeMarkdownLiveEditor.markdownOutline",
          "name": "Markdown Outline",
          "contextualTitle": "Outline"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"*.{md,json,ts,mjs}\" src tests scripts docs .vscode .github",
    "format:check": "prettier --check \"*.{md,json,ts,mjs}\" src tests scripts docs .vscode .github",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension-host": "npm run build && node ./scripts/run-extension-host-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run format:check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/vscode": "1.120.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "happy-dom": "20.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
